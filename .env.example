# One place to switch the game API URL.
# Keep /api/game when the website and API are in this same Next.js app.
# Use a full URL when the API is deployed somewhere else.
GAME_API_URL=/api/game

# Optional durable production session store.
# Vercel KV and Upstash Redis both expose these REST env vars.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# SESSION_STORE_NAMESPACE=game-recreation
